<import src="../../templates/status.wxml"/>
<wxs module="fmt" src="../../templates/format.wxs"/>
<view class="page" style="--text-scale:{{textScale}}">
  <view class="page-header"><view class="eyebrow">PROFILE · 我的</view><view class="title">我的身体，我做主</view><view class="subtitle">你的记录只属于你。</view></view>
  <template is="status" data="{{loading,error,busy,notice}}"/>
  <view class="card account-card"><view class="tag-row"><text class="pill {{signedIn ? 'success' : 'neutral'}}">{{signedIn ? '已连接' : '未连接'}}</text><text class="small muted">私人空间</text></view><view class="h2">{{signedIn ? '私有账户已连接' : '连接我的账户'}}</view><view class="muted">以微信身份登录后保存旅程、实验与身体记录。免费使用，无支付与微信提醒。</view><button class="text-button" bindtap="openPrivacy">阅读隐私保护指引 ↗</button><button wx:if="{{!signedIn}}" class="primary" bindtap="login" loading="{{busy}}" disabled="{{busy}}">阅读说明并微信登录</button></view>
  <view class="section-head"><view class="h2">数据与授权</view><text class="small muted">由你决定</text></view>
  <view class="card"><view class="settings-title"><view class="h2">Apple 健康</view><text class="pill neutral">需 iOS 同步</text></view><view class="muted">小程序不能直接读取 HealthKit。请通过 FitCrew iOS 客户端授权并同步；只有绑定到同一账户的数据才会在这里显示。</view><block wx:if="{{state}}"><view class="sync-state"><view class="body">已同步 {{state.health.sample_count}} 条</view><view class="small muted">最后同步：{{state.health.last_sync_at || '尚无同步'}}</view></view></block></view>
  <view class="card" wx:if="{{signedIn}}"><view class="h3">连接 FitCrew iOS</view><view class="muted">在自己的 iPhone 上连接当前微信账号。连接后读取同一份记录，健康上传需另行授权。已有 Apple 登录账号不会自动合并。</view><button class="secondary" bindtap="createPairing" loading="{{pairingBusy}}" disabled="{{busy || pairingBusy}}">生成一次性连接</button><block wx:if="{{pairingURL}}"><view class="small muted">有效至 {{fmt.time(pairingExpires)}}，限使用一次。请勿发送给他人。</view><button class="primary" bindtap="copyPairing" disabled="{{busy || pairingBusy}}">复制连接到自己的 iPhone</button><view class="small muted">打开 FitCrew iOS → 我的 → 粘贴连接并确认。离开此页会隐藏链接。</view></block><button class="quiet" bindtap="cancelPairing" disabled="{{busy || pairingBusy}}">撤销未使用的连接</button><view class="list-item" wx:for="{{pairedDevices}}" wx:key="id"><view class="body">已连接的 iPhone {{index + 1}}</view><view class="small muted">连接于 {{fmt.time(item.connected_at)}}<view>最后同步：{{fmt.time(item.last_sync_at)}}</view><view>会话到期：{{fmt.time(item.expires_at)}}</view></view><button class="danger" bindtap="disconnectDevice" data-id="{{item.id}}" disabled="{{busy || pairingBusy}}">断开此设备</button></view></view>
  <view class="card"><view class="settings-title"><view class="h2">AI 实验选择</view><text wx:if="{{caps}}" class="pill {{caps.ai_consent_granted ? 'success' : 'neutral'}}">{{caps.ai_consent_granted ? '已同意' : '未同意'}}</text></view><block wx:if="{{caps}}"><view class="body">{{caps.ai_notice}}</view><view class="small muted helper">服务商：{{caps.ai_provider || '尚未配置'}}<view>披露版本：{{caps.ai_notice_version || '尚未配置'}}</view></view><view wx:if="{{!caps.ai_available}}" class="notice">AI 服务当前不可用。规则建议会明确标记为「规则建议」。</view><button class="secondary" bindtap="ai" disabled="{{busy || (!caps.ai_available && !caps.ai_consent_granted)}}">{{caps.ai_consent_granted ? '撤回 AI 使用同意' : '阅读并单独同意 AI 使用'}}</button></block><view wx:else class="muted">登录并读取服务能力后显示服务商与授权状态。</view></view>
  <view class="section-head" wx:if="{{state}}"><view class="h2">我确认的记忆</view><text class="small muted">可以撤回</text></view>
  <view class="card" wx:if="{{state}}"><view class="small muted">主观反馈，不是疗效结论；不会自动发送给 AI。</view><view wx:if="{{!state.confirmed_memories.length}}" class="memory-empty"><view class="h3">还没有确认的记忆</view><view class="muted">实验回顾后，由你决定是否记住。</view></view><view class="list-item" wx:for="{{state.confirmed_memories}}" wx:key="id"><view class="body">{{item.text}}</view><view class="small muted helper">来自「{{item.experiment_title}}」</view><view class="small muted">确认于 {{fmt.time(item.confirmed_at)}}</view><button class="danger" data-id="{{item.id}}" bindtap="forgetMemory" disabled="{{busy}}">撤回记忆</button></view></view>
  <view class="section-head"><view class="h2">管理我的记录</view></view>
  <view class="card"><view class="h3">导出与本机文件</view><view class="small muted">导出由你发起，保存位置由你选择。</view><view class="field">导出范围</view><picker disabled="{{busy}}" range="{{exportScopes}}" value="{{exportScopeIndex}}" bindchange="selectExportScope" aria-label="导出范围"><view class="input picker-row"><text>{{exportScopes[exportScopeIndex]}}</text><text class="chevron">⌄</text></view></picker><button class="secondary" bindtap="exportData" disabled="{{busy || !signedIn}}">导出我的数据</button><block wx:if="{{exportPath}}"><view class="notice small">已写入本机私有沙箱：{{exportPath}}</view><button class="primary" bindtap="shareExport" disabled="{{busy}}">选择导出文件的接收位置</button></block><button class="quiet" bindtap="clearExport" disabled="{{busy}}">清除本机导出（含上次保存）</button></view>
  <view class="card data-removal"><view class="h3">删除与注销</view><view class="small muted">操作前会再次确认影响，完成后显示服务回执。</view><view class="field">删除范围</view><picker disabled="{{busy}}" range="{{deleteScopes}}" value="{{deleteScopeIndex}}" bindchange="selectDeleteScope" aria-label="删除范围"><view class="input picker-row"><text>{{deleteScopes[deleteScopeIndex]}}</text><text class="chevron">⌄</text></view></picker><button class="danger" bindtap="erase" data-kind="data" disabled="{{busy || !signedIn}}">删除所选范围的数据</button><button class="danger" bindtap="erase" data-kind="account" disabled="{{busy || !signedIn}}">注销账户</button></view>
  <view wx:if="{{receipt}}" class="notice success small" role="status">服务端删除回执：{{receipt}}</view>
  <view class="footer">FitCrew 提供生活方式记录与观察。实验结果不证明因果，不用于医疗诊断、治疗或用药。隐私说明版本 2026-09-07。</view>
</view>

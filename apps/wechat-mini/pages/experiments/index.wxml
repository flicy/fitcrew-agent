<import src="../../templates/status.wxml"/>
<wxs module="fmt" src="../../templates/format.wxs"/>
<view class="page" style="--text-scale:{{textScale}}">
  <view class="page-header"><view class="eyebrow">EXPERIMENTS · 小实验</view><view class="title">把好奇，变成观察</view><view class="subtitle">先确认一个小假设，再看看真实发生了什么。</view></view>
  <template is="status" data="{{loading,error,busy,notice}}"/>
  <view class="experiment-intro"><view class="experiment-steps"><text>提案</text><text>→</text><text>你确认</text><text>→</text><text>观察与回顾</text></view><button class="primary" bindtap="propose" loading="{{busy}}" disabled="{{busy || !state.journey}}">获取一个实验提案 <text class="intro-plus">＋</text></button><view wx:if="{{!state.journey}}" class="small muted helper">请先在「旅程」选择目标。</view><button wx:if="{{state && !state.journey}}" class="text-button" bindtap="openJourney">去选择旅程 →</button></view>
  <view wx:if="{{state && !experiments.length}}" class="card empty"><view class="empty-symbol" aria-hidden="true">↗</view><view class="h2">一个小小的开始</view><view class="muted">还没有实验。提案经你确认后才会开始，你可以随时暂停或停止。</view></view>
  <view class="card experiment-card" wx:for="{{experiments}}" wx:key="id">
    <view class="tag-row"><text class="pill {{item.status === 'paused' ? 'paused' : item.status === 'completed' ? 'success' : item.status === 'stopped' ? 'neutral' : ''}}">{{item.statusLabel}}</text><text class="small muted">{{item.sourceLabel}}</text></view>
    <view class="h2">{{item.title}}</view>
    <view class="experiment-hypothesis"><view class="section-label">想观察的问题</view><view class="body helper">{{item.hypothesis}}</view></view>
    <view class="field">这次的小行动</view><view class="body">{{item.intervention}}</view>
    <view class="small muted helper">持续 {{item.duration_days}} 天<text wx:if="{{item.ends_at}}"> · 下次评估 {{fmt.time(item.ends_at)}}</text></view>
    <button wx:if="{{item.status !== 'proposed'}}" class="text-button disclosure-toggle" bindtap="toggleDetails" data-id="{{item.id}}" aria-expanded="{{expandedExperiment === item.id}}">{{expandedExperiment === item.id ? '收起观察范围与说明 ↑' : '观察范围与数据使用 ↓'}}</button>
    <view wx:if="{{item.status === 'proposed' || expandedExperiment === item.id}}" class="experiment-disclosure">
      <view class="field">目的与时间窗</view><view class="body">{{item.purpose || '用于本人的生活方式观察；开始前七天为基线，开始后七天为观察期，两窗各至少四个记录日才比较。'}}</view>
      <view wx:if="{{item.baseline_start}}" class="small muted helper">基线 {{item.baseline_start}} — {{item.accepted_at}}（不含开始时刻）</view>
      <view wx:if="{{item.accepted_at}}" class="small muted helper">观察 {{item.accepted_at}} — {{item.ends_at}}，暂停时段不计入；不足四个记录日会如实显示。</view>
      <view class="field">观察指标</view><view class="body detail-row" wx:for="{{item.metrics}}" wx:for-item="metric" wx:key="*this">{{metric}}</view>
      <view class="field">判断标准</view><view class="body detail-row" wx:for="{{item.success_criteria}}" wx:for-item="criterion" wx:key="*this">{{criterion}}</view>
      <view class="field">停止条件</view><view class="body detail-row" wx:for="{{item.stop_conditions}}" wx:for-item="condition" wx:key="*this">{{condition}}</view>
      <view class="field">数据使用</view><view class="body detail-row" wx:for="{{item.data_categories}}" wx:for-item="category" wx:key="*this">{{category}}</view>
      <view class="small muted helper">自愿参加，可暂停或停止。结果只描述相关变化，不证明因果。</view>
    </view>
    <view wx:if="{{item.resultText}}" class="experiment-result"><view class="section-label">观察结果</view><view class="body helper">{{item.resultText}}</view></view>
    <view wx:if="{{item.health_observation}}" class="experiment-result">
      <view class="section-label">健康样本观察</view>
      <view wx:for="{{item.health_observation.metrics}}" wx:for-item="healthMetric" wx:key="key" class="helper">
        <view class="h3">{{healthMetric.label}}</view><view class="body">{{healthMetric.summary}}</view>
        <view class="small muted">来源：{{healthMetric.source_text}}</view>
      </view>
      <view class="small muted helper">时区：{{item.health_observation.timezone}}</view>
      <view class="small muted helper">{{item.health_observation.notice}}</view>
    </view>
    <view wx:if="{{item.status === 'completed' && (item.result.status === 'descriptive_only' || item.result.status === 'insufficient_data')}}" class="experiment-feedback">
      <view class="h3">这次行动适合你吗？</view><view class="small muted">先选择感受，再决定仅保存反馈，或单独确认为记忆。「暂不确定」只保存反馈。</view>
      <view wx:if="{{item.user_feedback}}" class="notice success small">已保存反馈：{{item.user_feedback.assessment === 'fits' ? '适合我' : item.user_feedback.assessment === 'not_fit' ? '不适合我' : '暂不确定'}}</view>
      <view class="feedback-options"><button class="option {{item.user_feedback.assessment === 'fits' ? 'selected' : ''}}" data-id="{{item.id}}" data-assessment="fits" bindtap="feedback" disabled="{{busy}}">适合我</button><button class="option {{item.user_feedback.assessment === 'not_fit' ? 'selected' : ''}}" data-id="{{item.id}}" data-assessment="not_fit" bindtap="feedback" disabled="{{busy}}">不适合我</button><button class="option {{item.user_feedback.assessment === 'uncertain' ? 'selected' : ''}}" data-id="{{item.id}}" data-assessment="uncertain" bindtap="feedback" disabled="{{busy}}">暂不确定</button></view>
      <view class="small muted helper">主观记忆可撤回，不是疗效结论，不会自动发送给 AI。</view>
    </view>
    <button wx:if="{{item.status === 'proposed'}}" class="primary" bindtap="transition" data-id="{{item.id}}" data-action="accept" disabled="{{busy}}">阅读并确认开始</button>
    <view class="row"><button wx:if="{{item.status === 'running'}}" class="secondary" bindtap="transition" data-id="{{item.id}}" data-action="pause" disabled="{{busy}}">暂停观察</button><button wx:if="{{item.status === 'paused'}}" class="secondary" bindtap="transition" data-id="{{item.id}}" data-action="resume" disabled="{{busy}}">继续观察</button><button wx:if="{{item.status === 'proposed' || item.status === 'running' || item.status === 'paused'}}" class="danger" bindtap="transition" data-id="{{item.id}}" data-action="stop" disabled="{{busy}}">停止实验</button></view>
    <button wx:if="{{item.status === 'running'}}" class="quiet" bindtap="transition" data-id="{{item.id}}" data-action="evaluate" disabled="{{busy}}">观察期结束后评估</button>
  </view>
  <view class="footer">先观察，再回顾。记录不足或结果失效时，会如实说明。</view>
</view>

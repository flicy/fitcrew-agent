<import src="../../templates/status.wxml"/><view class="page"><view class="eyebrow">FITCREW · EXPERIMENTS</view><view class="title">把好奇，变成观察</view><view class="subtitle">先确认一个小假设，再看看真实发生了什么。</view><template is="status" data="{{loading,error,busy}}"/><button class="primary" bindtap="propose" disabled="{{busy || !state.journey}}">获取一个实验提案</button><view wx:if="{{!state.journey}}" class="muted">请先在「旅程」选择目标。</view><view wx:if="{{state &amp;&amp; !experiments.length}}" class="card muted">还没有实验。提案经你确认后才会开始。</view><view class="card" wx:for="{{experiments}}" wx:key="id"><view class="pill">{{item.statusLabel}} · {{item.sourceLabel}}</view><view class="h2">{{item.title}}</view><view class="body">假设：{{item.hypothesis}}</view><view class="body">行动：{{item.intervention}}</view><view class="small muted">持续 {{item.duration_days}} 天<text wx:if="{{item.ends_at}}"> · 下次评估 {{item.ends_at}}</text></view><view class="divider"/><view class="small">观察指标</view><view class="body" wx:for="{{item.metrics}}" wx:for-item="metric" wx:key="*this">{{metric}}</view><view class="small">判断标准</view><view class="body" wx:for="{{item.success_criteria}}" wx:for-item="criterion" wx:key="*this">{{criterion}}</view><view class="small">停止条件</view><view class="body" wx:for="{{item.stop_conditions}}" wx:for-item="condition" wx:key="*this">{{condition}}</view><view class="small">数据使用</view><view class="body" wx:for="{{item.data_categories}}" wx:for-item="category" wx:key="*this">{{category}}</view><view wx:if="{{item.resultText}}" class="card hero body">{{item.resultText}}</view><button wx:if="{{item.status === 'proposed'}}" class="primary" bindtap="transition" data-id="{{item.id}}" data-action="accept" disabled="{{busy}}">阅读并确认开始</button><button wx:if="{{item.status === 'running'}}" bindtap="transition" data-id="{{item.id}}" data-action="pause" disabled="{{busy}}">暂停观察</button><button wx:if="{{item.status === 'paused'}}" bindtap="transition" data-id="{{item.id}}" data-action="resume" disabled="{{busy}}">继续观察</button><button wx:if="{{item.status === 'running'}}" bindtap="transition" data-id="{{item.id}}" data-action="evaluate" disabled="{{busy}}">观察期结束后评估</button><button wx:if="{{item.status === 'proposed' || item.status === 'running' || item.status === 'paused'}}" class="danger" bindtap="transition" data-id="{{item.id}}" data-action="stop" disabled="{{busy}}">停止实验</button></view></view>

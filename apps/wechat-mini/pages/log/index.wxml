<import src="../../templates/status.wxml"/><view class="page"><view class="eyebrow">FITCREW · LOG</view><view class="title">听听身体怎么说</view><view class="subtitle">没有标准答案，记下此刻就好。</view><template is="status" data="{{loading,error,busy}}"/><view class="card"><view class="h2">Body Check</view><view class="field">精力 {{energy}} / 5</view><slider disabled="{{busy}}" min="1" max="5" step="1" value="{{energy}}" activeColor="#7757A5" data-field="energy" bindchange="edit"/><view class="field">压力 {{stress}} / 3</view><slider disabled="{{busy}}" min="1" max="3" step="1" value="{{stress}}" activeColor="#7757A5" data-field="stress" bindchange="edit"/><view class="field">身体感受</view><picker disabled="{{busy}}" range="{{feelings}}" value="{{feelingIndex}}" data-field="feelingIndex" bindchange="edit"><view class="input">{{feelings[feelingIndex]}} · 点击选择</view></picker><view class="field">睡醒感受（可选）</view><picker disabled="{{busy}}" range="{{sleepFeelings}}" value="{{sleepIndex}}" data-field="sleepIndex" bindchange="edit"><view class="input">{{sleepFeelings[sleepIndex]}} · 点击选择</view></picker><view class="field">运动感受（可选）</view><picker disabled="{{busy}}" range="{{trainingFeelings}}" value="{{trainingIndex}}" data-field="trainingIndex" bindchange="edit"><view class="input">{{trainingFeelings[trainingIndex]}} · 点击选择</view></picker><view class="field">压力来源（可选）</view><picker disabled="{{busy}}" range="{{stressSources}}" value="{{sourceIndex}}" data-field="sourceIndex" bindchange="edit"><view class="input">{{stressSources[sourceIndex]}} · 点击选择</view></picker><view wx:if="{{feelings[feelingIndex] === '不适'}}"><view class="body">感到不适时，请先停止当前实验，必要时寻求专业帮助。</view><button bindtap="openExperiments">前往实验，选择停止</button></view><view class="field">补充几句话（可选）</view><textarea disabled="{{busy}}" class="input note" value="{{note}}" maxlength="500" data-field="note" bindinput="edit" placeholder="有什么想记住的？"/><view class="small muted">草稿只保存在本机；保存后发送到你的私有账户。</view><button class="primary" bindtap="save" disabled="{{busy || !state}}">保存身体记录</button></view><view wx:if="{{receipt}}" class="small muted">删除回执：{{receipt}}</view><view class="card" wx:if="{{state}}"><view class="h2">我的记录</view><view wx:if="{{!logs.length}}" class="muted">尚无记录。</view><view wx:for="{{logs}}" wx:key="id"><view class="divider"/><view class="small muted">{{item.created_at}}</view><view class="body">{{item.feeling}} · 精力 {{item.energy}} / 5 · 压力 {{item.stress}} / 3</view><view wx:if="{{item.sleep_feeling}}">睡醒：{{item.sleep_feeling}}</view><view wx:if="{{item.training_feeling}}">运动：{{item.training_feeling}}</view><view wx:if="{{item.stress_source}}">压力来源：{{item.stress_source}}</view><view class="body">{{item.note}}</view><button class="danger" bindtap="remove" data-id="{{item.id}}" disabled="{{busy}}">删除这条记录</button></view></view></view>

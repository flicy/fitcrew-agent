<import src="../../templates/status.wxml"/>
<wxs module="fmt" src="../../templates/format.wxs"/>
<view class="page" style="--text-scale:{{textScale}}">
  <view class="page-header"><view class="eyebrow">CHECK IN · 身体记录</view><view class="title">听听身体怎么说</view><view class="subtitle">没有标准答案，记下此刻就好。</view></view>
  <template is="status" data="{{loading,error,busy,notice}}"/>
  <view class="card log-form">
    <view class="tag-row"><text class="pill">BODY CHECK</text><text class="small muted">仅自己可见</text></view>
    <view class="field-head"><view class="h2">现在精力怎么样？</view><text class="energy-value">{{energy}}<text class="small"> / 5</text></text></view>
    <view class="scale-options" role="group" aria-label="精力，1 到 5 档"><button wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="option scale-option {{energy === item ? 'selected' : ''}}" data-field="energy" data-value="{{item}}" bindtap="choose" disabled="{{busy}}" aria-label="精力 {{item}}，{{energyLabels[index]}}" aria-pressed="{{energy === item}}">{{item}}</button></view>
    <view class="scale-labels"><text>很低</text><text class="scale-selected">{{energyLabels[energy - 1]}}</text><text>充足</text></view>
    <view class="divider"/>
    <view class="field-head"><view class="h3">此刻的压力</view><text class="small muted">{{stress}} / 3</text></view>
    <view class="option-grid stress-options" role="group" aria-label="压力"><button wx:for="{{['低','中','高']}}" wx:key="*this" class="option {{stress === index + 1 ? 'selected' : ''}}" data-field="stress" data-value="{{index + 1}}" bindtap="choose" disabled="{{busy}}" aria-pressed="{{stress === index + 1}}">{{stress === index + 1 ? '✓ ' : ''}}{{item}}</button></view>
    <view class="field">身体感受</view>
    <view class="option-grid feeling-options" role="group" aria-label="身体感受"><button wx:for="{{feelings}}" wx:key="*this" class="option {{feelingIndex === index ? 'selected' : ''}}" data-field="feelingIndex" data-value="{{index}}" bindtap="choose" disabled="{{busy}}" aria-pressed="{{feelingIndex === index}}">{{feelingIndex === index ? '✓ ' : ''}}{{item}}</button></view>
    <view wx:if="{{feelings[feelingIndex] === '不适'}}" class="notice discomfort"><view class="h3">先照顾好自己</view><view>感到不适时，请先停止当前实验，必要时寻求专业帮助。</view><button class="secondary" bindtap="openExperiments">前往实验，选择停止</button></view>
    <view class="divider"/><view class="h3">多留一点线索</view><view class="small muted">以下均可选，按今天的实际情况记录。</view>
    <view class="field">睡醒感受</view><picker disabled="{{busy}}" range="{{sleepFeelings}}" value="{{sleepIndex}}" data-field="sleepIndex" bindchange="edit" aria-label="睡醒感受"><view class="input picker-row"><text>{{sleepFeelings[sleepIndex]}}</text><text class="chevron">⌄</text></view></picker>
    <view class="field">运动感受</view><picker disabled="{{busy}}" range="{{trainingFeelings}}" value="{{trainingIndex}}" data-field="trainingIndex" bindchange="edit" aria-label="运动感受"><view class="input picker-row"><text>{{trainingFeelings[trainingIndex]}}</text><text class="chevron">⌄</text></view></picker>
    <view class="field">压力来源</view><picker disabled="{{busy}}" range="{{stressSources}}" value="{{sourceIndex}}" data-field="sourceIndex" bindchange="edit" aria-label="压力来源"><view class="input picker-row"><text>{{stressSources[sourceIndex]}}</text><text class="chevron">⌄</text></view></picker>
    <view class="field">补充几句话</view><textarea disabled="{{busy}}" class="input note" value="{{note}}" maxlength="500" data-field="note" bindinput="edit" placeholder="有什么想记住的？" aria-label="补充说明，最多 500 字"/><view class="note-count small muted">{{note.length}} / 500</view>
    <view class="save-panel"><view wx:if="{{error}}" class="small save-error">提交失败时会保留所选内容，可以重试。</view><view class="small muted">草稿只保存在本机；保存后发送到你的私有账户。</view><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy || !state}}">{{busy ? '正在保存…' : '保存身体记录'}}</button><view wx:if="{{!state}}" class="small muted helper">请先连接账户，或重新读取服务状态。</view></view>
  </view>
  <view wx:if="{{receipt}}" class="notice success small">删除回执：{{receipt}}</view>
  <view class="section-head" wx:if="{{state}}"><view class="h2">我的记录</view><text class="small muted">随时查看与删除</text></view>
  <view class="card" wx:if="{{state}}"><view wx:if="{{!logs.length}}" class="muted">尚无记录。保存后的感受会出现在这里。</view><view class="list-item" wx:for="{{logs}}" wx:key="id"><view class="small muted">{{fmt.time(item.created_at)}}</view><view class="h3">{{item.feeling}}</view><view class="body">精力 {{item.energy}} / 5 · 压力 {{item.stress}} / 3</view><view class="small" wx:if="{{item.sleep_feeling}}">睡醒：{{item.sleep_feeling}}</view><view class="small" wx:if="{{item.training_feeling}}">运动：{{item.training_feeling}}</view><view class="small" wx:if="{{item.stress_source}}">压力来源：{{item.stress_source}}</view><view class="body" wx:if="{{item.note}}">{{item.note}}</view><button class="danger" bindtap="remove" data-id="{{item.id}}" disabled="{{busy}}">删除这条记录</button></view></view>
</view>

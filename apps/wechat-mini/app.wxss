page{background:#F5F1FA;color:#30263C;font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:32rpx}.page{padding:40rpx 32rpx 64rpx}.eyebrow{font-size:24rpx;letter-spacing:3rpx;color:#806894;margin-bottom:12rpx}.title{font-size:58rpx;font-weight:700;line-height:1.2;margin-bottom:16rpx}.subtitle,.muted{color:#7A7084;font-size:28rpx;line-height:1.65}.card{background:#fff;border-radius:32rpx;padding:32rpx;margin-top:24rpx}.hero{background:#E7DDF3}.h2{font-size:38rpx;font-weight:600;margin-bottom:18rpx}.body{line-height:1.65;white-space:pre-wrap}.small{font-size:26rpx;line-height:1.6}.pill{display:inline-block;background:#F1EBF7;border-radius:20rpx;padding:8rpx 18rpx;font-size:24rpx;margin-bottom:18rpx;color:#7757A5}button{min-height:96rpx;line-height:1.4;padding:24rpx;border-radius:26rpx;margin-top:20rpx;font-size:30rpx;background:#EEE7F5;color:#513C6D}button::after{border:0}button.primary{background:#7757A5;color:white}button.danger{color:#A33E56;background:#FAEDF0}button[disabled]{opacity:.5}.error{background:#FFF0EF;color:#9F3941;padding:24rpx;border-radius:20rpx;margin:24rpx 0;line-height:1.5}.field{margin-top:28rpx}.input{padding:22rpx;background:#F5F1FA;border-radius:18rpx;min-height:64rpx}.note{width:100%;box-sizing:border-box;height:190rpx}.row{display:flex;gap:16rpx}.row button{flex:1}.divider{height:1rpx;background:#EEE8F2;margin:24rpx 0}.value{font-size:46rpx;font-weight:600}.footer{margin-top:36rpx;color:#81758C;font-size:24rpx;line-height:1.6}
